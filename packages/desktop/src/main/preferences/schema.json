{
  "autoSave": { "type": "boolean", "default": false },
  "autoSaveDelay": { "type": "number", "minimum": 1000, "default": 5000 },
  "zoomFactor": { "type": "number", "minimum": 0.5, "maximum": 2, "default": 1 },
  "titleBarStyle": { "enum": ["custom", "native"], "default": "custom" },
  "language": { "enum": ["en", "zh-CN"], "default": "en" },
  "editorFontFamily": { "type": "string", "default": "Open Sans" },
  "fontSize": { "type": "number", "minimum": 12, "maximum": 32, "default": 16 },
  "lineHeight": { "type": "number", "minimum": 1.2, "maximum": 2, "default": 1.6 },
  "codeFontSize": { "type": "number", "minimum": 12, "maximum": 28, "default": 14 },
  "codeFontFamily": { "type": "string", "default": "DejaVu Sans Mono" },
  "codeBlockLineNumbers": { "type": "boolean", "default": false },
  "trimUnnecessaryCodeBlockEmptyLines": { "type": "boolean", "default": true },
  "wrapCodeBlocks": { "type": "boolean", "default": false },
  "editorLineWidth": { "type": "string", "pattern": "^(?:$|[0-9]+(?:ch|px|%)$)", "default": "80%" },
  "autoPairBracket": { "type": "boolean", "default": true },
  "autoPairMarkdownSyntax": { "type": "boolean", "default": true },
  "autoPairQuote": { "type": "boolean", "default": true },
  "textDirection": { "enum": ["ltr", "rtl"], "default": "ltr" },
  "hideQuickInsertHint": { "type": "boolean", "default": false },
  "hideLinkPopup": { "type": "boolean", "default": false },
  "autoCheck": { "type": "boolean", "default": false },
  "preferLooseListItem": { "type": "boolean", "default": true },
  "bulletListMarker": { "enum": ["-", "*", "+"], "default": "-" },
  "orderListDelimiter": { "enum": [".", ")"], "default": "." },
  "tabSize": { "type": "number", "default": 4 },
  "listIndentation": { "enum": ["dfm", "tab", 1, 2, 3, 4], "default": 1 },
  "frontmatterType": { "enum": ["-", "+", ";", "{"], "default": "-" },
  "superSubScript": { "type": "boolean", "default": false },
  "footnote": { "type": "boolean", "default": false },
  "isHtmlEnabled": { "type": "boolean", "default": true },
  "isGitlabCompatibilityEnabled": { "type": "boolean", "default": false },
  "sequenceTheme": { "enum": ["hand", "simple"], "default": "hand" },
  "plantumlServer": { "type": "string", "pattern": "^(https?://|$)", "default": "https://www.plantuml.com/plantuml" },
  "theme": { "type": "string", "default": "light" },
  "followSystemTheme": { "type": "boolean", "default": true },
  "lightModeTheme": { "type": "string", "default": "light" },
  "darkModeTheme": { "type": "string", "default": "dark" },
  "customCss": { "type": "string", "default": "" },
  "spellcheckerEnabled": { "type": "boolean", "default": false },
  "spellcheckerNoUnderline": { "type": "boolean", "default": false },
  "spellcheckerLanguage": { "type": "string", "default": "en-US" }
}
